# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_BEHIND_PROXY=1

# Database — leave empty for SQLite, or use postgres://user:pass@host:5432/db
DATABASE_URL=

# Security overrides (optional)
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# External data sources
NASA_POWER_TIMEOUT=45
NASA_CMR_TIMEOUT=45
NASA_EARTHDATA_TOKEN=
NASA_DOWNLOAD_MAX_MB=100
FAO_TIMEOUT=30
FAO_API_KEY=
DATA_ALLOWED_HOSTS=

# Public demo mode — anonymous visitors get an isolated demo farmer account (Render demo only)
PUBLIC_DEMO=0
